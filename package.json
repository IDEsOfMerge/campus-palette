    "commands": [
      {
        "command": "campusPalette.toggleTheme",
        "title": "Campus Palette: Toggle Light / Dark Theme"
      },
      {
        "command": "campusPalette.pickTheme",
        "title": "Campus Palette: Choose University Theme"
      },
      {
        "command": "campusPalette.pickSimilarTheme",
        "title": "Campus Palette: Pick Chromatically Similar Theme"
      },
      {
        "command": "campusPalette.randomTheme",
        "title": "Campus Palette: Random University Theme"
      },
      {
        "command": "campusPalette.randomThemeSameMode",
        "title": "Campus Palette: Random Theme (Keep Light / Dark Mode)"
      },
      {
        "command": "campusPalette.syncOsThemePair",
        "title": "Campus Palette: Sync Light & Dark Pair with OS Appearance"
      },
      {
        "command": "campusPalette.openExplorer",
        "title": "Campus Palette: Open Interactive Theme Explorer"
      }
    ],
    "configuration": {
      "title": "Campus Palette",
      "properties": {
        "campusPalette.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show or hide the **Campus Palette** university theme quick-picker item in the status bar."
        }
      }
    },
    "keybindings": [
      {
        "command": "campusPalette.toggleTheme",
        "key": "ctrl+k ctrl+u",
        "mac": "cmd+k cmd+u"
      }
    ],
    "walkthroughs": [
      {
        "id": "campusPalette.gettingStarted",
        "title": "Welcome to Campus Palette",
        "description": "40 iconic universities across 6 collegiate groupings · 80 scientifically tuned Light & Dark themes — a quick tour.",
        "steps": [
          {
            "id": "pickTheme",
            "title": "Choose your campus theme (with live preview)",
            "description": "Every one of the 40 universities across the Ivy League, Canadian Universities, US Public Flagships, US Private Research & STEM, Liberal Arts & Regional Gems, and Global Classics gets a matched Light and Dark pair crafted in OKLCH from official campus color palettes. Arrow through the list to preview live before committing.\n[Choose a University Theme](command:campusPalette.pickTheme)",
            "media": {
              "image": "icon.png",
              "altText": "Campus Palette emblem"
            },
            "completionEvents": [
              "onCommand:campusPalette.pickTheme"
            ]
          },
          {
            "id": "toggle",
            "title": "Toggle Light and Dark for your active campus",
            "description": "A smart, per-university toggle that flips cleanly between the sunlit quad Light variant and late-night library Dark variant of whichever campus theme is active. Bound to `ctrl+k ctrl+u` (`cmd+k cmd+u` on Mac), or run it from the Command Palette.\n[Toggle Light / Dark Theme](command:campusPalette.toggleTheme)",
            "media": {
              "markdown": "assets/walkthrough/toggle.md"
            },
            "completionEvents": [
              "onCommand:campusPalette.toggleTheme"
            ]
          },
          {
            "id": "heritage",
            "title": "Official institutional hues, engineered for long sessions",
            "description": "From Harvard Crimson and Yale Blue to Oxford Navy, ETH Zurich Cobalt, U of T Blue, UT Austin Burnt Orange, and St. Edward's Hilltop Gold — each campus's official brand palette is harmonized in OKLCH with campus stone, brick, and slate surfaces so every syntax token stays unmistakable.",
            "media": {
              "image": "icon.png",
              "altText": "Campus Palette Light and Dark emblem"
            }
          },
          {
            "id": "colorScience",
            "title": "Launch the Interactive Theme & Colorimetry Explorer",
            "description": "Inspect OKLCH coordinates, WCAG 2.1 + APCA contrast, perceptual CIEDE2000 similarity maps, and real-time protanopia/deuteranopia/tritanopia simulations across all 80 themes — and apply any campus straight into your editor.\n[Open Interactive Theme Explorer](command:campusPalette.openExplorer)",
            "media": {
              "markdown": "assets/walkthrough/color-science.md"
            },
            "completionEvents": [
              "onCommand:campusPalette.openExplorer"
            ]
          }
        ]
      }
    ]
